<shapes name="osiris.pid.instruments">
  <!--
    ISA-5.1 instrument bubbles, authored for Osiris DEXPI.
    No tag text is baked in - the DEXPI tag name is rendered as the maxGraph cell label.
    Geometry encodes the *display/interface* type; the location line encodes where it is mounted.
  -->

  <!-- Field-mounted / local: plain circle -->
  <shape name="Discrete" aspect="fixed" h="80" w="80" strokewidth="inherit">
    <connections>
      <constraint name="N" perimeter="0" x="0.5" y="0"/>
      <constraint name="S" perimeter="0" x="0.5" y="1"/>
      <constraint name="W" perimeter="0" x="0" y="0.5"/>
      <constraint name="E" perimeter="0" x="1" y="0.5"/>
    </connections>
    <background>
      <ellipse x="0" y="0" w="80" h="80"/>
    </background>
    <foreground>
      <fillstroke/>
    </foreground>
  </shape>

  <!-- Primary location, normally accessible: circle with solid centre line -->
  <shape name="Discrete Field" aspect="fixed" h="80" w="80" strokewidth="inherit">
    <connections>
      <constraint name="N" perimeter="0" x="0.5" y="0"/>
      <constraint name="S" perimeter="0" x="0.5" y="1"/>
      <constraint name="W" perimeter="0" x="0" y="0.5"/>
      <constraint name="E" perimeter="0" x="1" y="0.5"/>
    </connections>
    <background>
      <ellipse x="0" y="0" w="80" h="80"/>
    </background>
    <foreground>
      <fillstroke/>
      <path>
        <move x="0" y="40"/>
        <line x="80" y="40"/>
      </path>
      <stroke/>
    </foreground>
  </shape>

  <!-- Shared display / shared control (DCS): circle inscribed in a square -->
  <shape name="Shared Display" aspect="fixed" h="80" w="80" strokewidth="inherit">
    <connections>
      <constraint name="N" perimeter="0" x="0.5" y="0"/>
      <constraint name="S" perimeter="0" x="0.5" y="1"/>
      <constraint name="W" perimeter="0" x="0" y="0.5"/>
      <constraint name="E" perimeter="0" x="1" y="0.5"/>
    </connections>
    <background>
      <rect x="0" y="0" w="80" h="80"/>
    </background>
    <foreground>
      <fillstroke/>
      <ellipse x="4" y="4" w="72" h="72"/>
      <stroke/>
    </foreground>
  </shape>

  <!-- Computer function: hexagon -->
  <shape name="Computer Function" aspect="fixed" h="80" w="92" strokewidth="inherit">
    <connections>
      <constraint name="N" perimeter="0" x="0.5" y="0"/>
      <constraint name="S" perimeter="0" x="0.5" y="1"/>
      <constraint name="W" perimeter="0" x="0" y="0.5"/>
      <constraint name="E" perimeter="0" x="1" y="0.5"/>
    </connections>
    <background>
      <path>
        <move x="23" y="0"/>
        <line x="69" y="0"/>
        <line x="92" y="40"/>
        <line x="69" y="80"/>
        <line x="23" y="80"/>
        <line x="0" y="40"/>
        <close/>
      </path>
    </background>
    <foreground>
      <fillstroke/>
    </foreground>
  </shape>

  <!-- Programmable logic controller: square with inscribed diamond -->
  <shape name="Logic" aspect="fixed" h="80" w="80" strokewidth="inherit">
    <connections>
      <constraint name="N" perimeter="0" x="0.5" y="0"/>
      <constraint name="S" perimeter="0" x="0.5" y="1"/>
      <constraint name="W" perimeter="0" x="0" y="0.5"/>
      <constraint name="E" perimeter="0" x="1" y="0.5"/>
    </connections>
    <background>
      <rect x="0" y="0" w="80" h="80"/>
    </background>
    <foreground>
      <fillstroke/>
      <path>
        <move x="40" y="4"/>
        <line x="76" y="40"/>
        <line x="40" y="76"/>
        <line x="4" y="40"/>
        <close/>
      </path>
      <stroke/>
    </foreground>
  </shape>
</shapes>
